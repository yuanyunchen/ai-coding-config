{
  "PreToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit|Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$HOME/.claude/hooks/discipline-reminders.py\"",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Agent|Task",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$HOME/.claude/hooks/workspace-guard.py\"",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$HOME/.claude/hooks/workspace-guard.py\"",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$HOME/.claude/hooks/workspace-guard.py\"",
          "timeout": 10
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$HOME/.claude/hooks/workspace-guard.py\"",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$HOME/.claude/hooks/workspace-guard.py\"",
          "timeout": 10
        }
      ]
    }
  ]
}
