{
  "model": "opus",
  "effortLevel": "high",
  "env": {
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-4-5-20251001"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force)",
      "Bash(git push --force*)",
      "Bash(git push -f)",
      "Bash(git push -f*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(launchctl bootout*)",
      "Write(~/Library/LaunchAgents/**)",
      "Edit(~/Library/LaunchAgents/**)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "skillListingBudgetFraction": 0.05,
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "agentPushNotifEnabled": true
}
